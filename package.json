{
  "name": "wxt-browser-extensions-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Monorepo with WXT browser extension, Hono server, and Vue web client",
  "scripts": {
    "dev": "pnpm --filter @wxt-ext/server dev & pnpm --filter @wxt-ext/webclient dev & pnpm --filter @wxt-ext/extension dev",
    "dev:server": "pnpm --filter @wxt-ext/server dev",
    "dev:extension": "pnpm --filter @wxt-ext/extension dev",
    "dev:webclient": "pnpm --filter @wxt-ext/webclient dev",
    "build": "pnpm -r build",
    "build:server": "pnpm --filter @wxt-ext/server build",
    "build:extension": "pnpm --filter @wxt-ext/extension build",
    "build:webclient": "pnpm --filter @wxt-ext/webclient build",
    "build:shared": "pnpm --filter @wxt-ext/shared build",
    "start": "pnpm --filter @wxt-ext/server start",
    "clean": "pnpm -r clean && rm -rf node_modules",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test"
  },
  "keywords": [
    "monorepo",
    "browser-extension",
    "wxt",
    "vue",
    "hono"
  ],
  "author": "touchx",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  },
  "packageManager": "pnpm@10.30.3+sha512.c961d1e0a2d8e354ecaa5166b822516668b7f44cb5bd95122d590dd81922f606f5473b6d23ec4a5be05e7fcd18e8488d47d978bbe981872f1145d06e9a740017"
}
